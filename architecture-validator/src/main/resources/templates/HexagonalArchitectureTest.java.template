package ${generatedPackage};

import com.tngtech.archunit.base.DescribedPredicate;
import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchCondition;
import com.tngtech.archunit.lang.ArchRule;
import com.tngtech.archunit.lang.ConditionEvents;
import com.tngtech.archunit.lang.SimpleConditionEvent;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

@AnalyzeClasses(packages = "${basePackage}")
class HexagonalArchitectureTest {

        private static final DescribedPredicate<JavaClass> INBOUND_PORT_INTERFACES =
                        new DescribedPredicate<>("inbound port interfaces") {
                                @Override
                                public boolean test(JavaClass input) {
                                        return input.isInterface()
                                                        && (input.getSimpleName().endsWith("UseCase")
                                                        || input.getSimpleName().endsWith("InputPort"));
                                }
                        };

        private static final DescribedPredicate<JavaClass> DOMAIN_OR_ALLOWED_JDK_CLASSES =
                        JavaClass.Predicates.resideInAnyPackage(
                                        ${domainModel})
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${domainAllowedPackages}));

        private static final DescribedPredicate<JavaClass> DOMAIN_SERVICE_ALLOWED_CLASSES =
                        JavaClass.Predicates.resideInAnyPackage(
                                        ${domainModel})
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${domainServices}))
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${inPorts}))
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${outPorts}))
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${domainAllowedPackages}));

        private static final DescribedPredicate<JavaClass> PORT_ALLOWED_CLASSES =
                        JavaClass.Predicates.resideInAnyPackage(
                                        ${domainModel})
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${inPorts}))
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${outPorts}))
                        .or(JavaClass.Predicates.resideInAnyPackage(
                                        ${domainAllowedPackages}));

        private static final ArchCondition<JavaClass> INBOUND_PORT_NAMING_CONVENTION =
                        new ArchCondition<>("have simple name ending with 'UseCase' or 'InputPort'") {
                                @Override
                                public void check(JavaClass javaClass, ConditionEvents events) {
                                        boolean matches = javaClass.getSimpleName().endsWith("UseCase")
                                                        || javaClass.getSimpleName().endsWith("InputPort");
                                        events.add(new SimpleConditionEvent(javaClass, matches,
                                                        javaClass.getName() + " has simple name ending with 'UseCase' or 'InputPort'"));
                                }
                        };

        private static final ArchCondition<JavaClass> DOMAIN_SERVICE_NAMING_CONVENTION =
                        new ArchCondition<>("have simple name ending with 'Service' or 'Policy'") {
                                @Override
                                public void check(JavaClass javaClass, ConditionEvents events) {
                                        boolean matches = javaClass.getSimpleName().endsWith("Service")
                                                        || javaClass.getSimpleName().endsWith("Policy");
                                        events.add(new SimpleConditionEvent(javaClass, matches,
                                                        javaClass.getName() + " has simple name ending with 'Service' or 'Policy'"));
                                }
                        };

    @ArchTest
    static final ArchRule domain_must_only_depend_on_domain_or_jdk_core =
            classes()
                    .that().resideInAnyPackage(
                            ${domainModel})
                    .should().onlyDependOnClassesThat(DOMAIN_OR_ALLOWED_JDK_CLASSES)
                    .allowEmptyShould(true)
                    .as("Domain model classes must only depend on the domain model itself or the configured "
                            + "allow-list of JDK packages — never adapters, domain services, ports, "
                            + "or any third-party/framework class");

    @ArchTest
    static final ArchRule domain_services_must_only_depend_on_domain_core_and_ports =
            classes()
                    .that().resideInAnyPackage(
                            ${domainServices})
                    .should().onlyDependOnClassesThat(DOMAIN_SERVICE_ALLOWED_CLASSES)
                    .allowEmptyShould(true)
                    .as("Domain service classes must only depend on the domain model, other domain services, "
                            + "inbound/outbound ports, or the configured allow-list of JDK packages — never "
                            + "adapters or any third-party/framework class");

    @ArchTest
    static final ArchRule ports_must_only_depend_on_domain_or_jdk_core =
            classes()
                    .that().resideInAnyPackage(
                            ${allPorts})
                    .should().onlyDependOnClassesThat(PORT_ALLOWED_CLASSES)
                    .allowEmptyShould(true)
                    .as("Port interfaces must stay free of framework dependencies — they may only depend on the "
                            + "domain model, other ports, or the configured allow-list of JDK packages");

    @ArchTest
    static final ArchRule inbound_ports_must_be_interfaces =
            classes()
                    .that().resideInAnyPackage(
                            ${inPorts})
                    .and().resideOutsideOfPackages(
                            ${portDataTypePackages})
                    .should().beInterfaces()
                    .allowEmptyShould(true)
                    .as("Inbound port contracts must be interfaces, not concrete classes");

    @ArchTest
    static final ArchRule outbound_ports_must_be_interfaces =
            classes()
                    .that().resideInAnyPackage(
                            ${outPorts})
                    .and().resideOutsideOfPackages(
                            ${portDataTypePackages})
                    .should().beInterfaces()
                    .allowEmptyShould(true)
                    .as("Outbound port contracts must be interfaces, not concrete classes");

    @ArchTest
    static final ArchRule inbound_ports_reside_in_correct_package =
            classes()
                    .that(INBOUND_PORT_INTERFACES)
                    .should().resideInAnyPackage(
                            ${inPorts})
                    .allowEmptyShould(true)
                    .as("Inbound port interfaces must reside in the inbound ports package");

    @ArchTest
    static final ArchRule core_layer_must_not_depend_on_adapters =
            noClasses()
                    .that().resideOutsideOfPackages(
                            ${allAdapters})
                    .should().dependOnClassesThat().resideInAnyPackage(
                            ${allAdapters})
                    .allowEmptyShould(true)
                    .as("Adapters are outer-layer details; the domain model, domain services, ports, and "
                            + "configuration must all be completely unaware of them");

    @ArchTest
    static final ArchRule adapters_must_not_depend_on_domain_services_directly =
            noClasses()
                    .that().resideInAnyPackage(
                            ${allAdapters})
                    .should().dependOnClassesThat().resideInAnyPackage(
                            ${domainServices})
                    .allowEmptyShould(true)
                    .as("Adapters must communicate with the application core only through ports — never by "
                            + "depending directly on a domain service implementation");

    @ArchTest
    static final ArchRule only_configuration_may_depend_on_domain_service_implementations =
            noClasses()
                    .that().resideOutsideOfPackages(
                            ${configurationPackages})
                    .and().resideOutsideOfPackages(
                            ${domainServices})
                    .should().dependOnClassesThat().resideInAnyPackage(
                            ${domainServices})
                    .allowEmptyShould(true)
                    .as("Concrete domain service implementations must only be referenced from configuration "
                            + "classes wiring up the corresponding bean — every other caller must go through a port");

    @ArchTest
    static final ArchRule core_application_layer_must_have_no_denylisted_dependencies =
            noClasses()
                    .that().resideInAnyPackage(
                            ${coreLayerPackages})
                    .should().dependOnClassesThat().resideInAnyPackage(
                            ${frameworkDenylistPackages})
                    .allowEmptyShould(true)
                    .as("Domain model, domain services, and ports must be completely free of the configured "
                            + "denylisted framework/library dependencies");
${namingConventionsSection}}
