package ${generatedPackage};

import com.tngtech.archunit.core.domain.JavaClasses;
import com.tngtech.archunit.core.importer.ClassFileImporter;
import com.tngtech.archunit.core.importer.ImportOption;
import org.junit.jupiter.api.Test;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

class HexagonalArchitectureTest {

    private static final String BASE_PACKAGE = "${basePackage}";

    private final JavaClasses classes = new ClassFileImporter()
            .withImportOption(ImportOption.Predefined.DO_NOT_INCLUDE_TESTS)
            .importPackages(BASE_PACKAGE);

    @Test
    void domainModelShouldOnlyDependOnJavaCoreAndDeclaredApplicationPackages() {
        classes()
                .that().resideInAnyPackage(
                        ${domainModel})
                .should().onlyDependOnClassesThat()
                .resideInAnyPackage(
                        "java.util..",
                        "java.lang..",
                        "java.time..",
                        ${domainModel},
                        ${inPorts},
                        ${outPorts},
                        ${commonPackages})
                .because("The core hexagon must stay free of framework and adapter details")
                .check(classes);
    }

    @Test
    void portsShouldBeInterfacesAndOnlyDependOnDomainModel() {
        classes()
                .that().resideInAnyPackage(
                        ${inPorts},
                        ${outPorts})
                .should().beInterfaces()
                .because("Ports are contracts, not implementations")
                .allowEmptyShould(true)
                .check(classes);

        classes()
                .that().resideInAnyPackage(
                        ${inPorts},
                        ${outPorts})
                .should().onlyDependOnClassesThat()
                .resideInAnyPackage(
                        "java.util..",
                        "java.lang..",
                        ${domainModel},
                        ${inPorts},
                        ${outPorts})
                .because("Port contracts must stay framework free")
                .allowEmptyShould(true)
                .check(classes);
    }

    @Test
    void coreApplicationLayerShouldNotDependOnAdapters() {
        noClasses()
                .that().resideOutsideOfPackage("..adapter..")
                .and().resideOutsideOfPackage("..adapters..")
                .should().dependOnClassesThat().resideInAnyPackage(
                        ${adapters})
                .because("Adapters are outer-layer details and must point inward")
                .check(classes);
    }

    @Test
    void commonPackagesShouldOnlyDependOnJavaCoreAndSharedPackages() {
        classes()
                .that().resideInAnyPackage(
                        ${commonPackages})
                .should().onlyDependOnClassesThat()
                .resideInAnyPackage(
                        "java.util..",
                        "java.lang..",
                        ${commonPackages})
                .because("Shared application utilities must stay free of framework dependencies")
                .allowEmptyShould(true)
                .check(classes);
    }

    @Test
    void applicationServicesShouldNotDependOnAdapters() {
        noClasses()
                .that().resideInAnyPackage(
                        ${applicationServices})
                .should().dependOnClassesThat().resideInAnyPackage(
                        ${adapters})
                .because("Application services should collaborate through ports, not concrete adapters")
                .allowEmptyShould(true)
                .check(classes);
    }
}